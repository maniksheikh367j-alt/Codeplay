rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "maniksheikh2006@gmail.com"
      );
    }

    function isValidAppSetting(data) {
      return data.keys().hasAll(['appName', 'appDescription', 'theme', 'language', 'aiConfig', 'updatedAt'])
        && data.appName is string && data.appName.size() <= 100
        && data.appDescription is string && data.appDescription.size() <= 500
        && data.theme in ['dark', 'neon', 'premium']
        && data.language in ['bn', 'en', 'hi', 'ur']
        && data.updatedAt == request.time;
    }

    // 1. Settings Collection
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin() && isValidAppSetting(request.resource.data);
    }

    // 2. Admins Collection
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
